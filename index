<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>YOURS SALON — Daily Ops Dashboard</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#12100E;
    --surface:#1B1815;
    --surface-2:#242019;
    --line:#332C22;
    --gold:#C9A227;
    --gold-soft:#E4C55C;
    --teal:#3E8272;
    --rust:#B5473F;
    --text:#F3EEE3;
    --muted:#9C9284;
    --faint:#5E574A;
    --radius:12px;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  body{
    background:
      radial-gradient(circle at 15% -10%, rgba(201,162,39,0.08), transparent 40%),
      var(--bg);
    color:var(--text);
    font-family:'Inter',sans-serif;
    min-height:100vh;
    padding:16px 12px 40px;
  }
  .wrap{max-width:1400px; margin:0 auto;}

  /* ===== HEADER ===== */
  header{
    display:flex; 
    flex-direction:column;
    gap:12px;
    margin-bottom:4px;
  }

  .header-main {
    width: 100%;
  }

  .brand-section {
    margin-bottom: 12px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--line);
    position: relative;
  }

  .brand-section::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 60px;
    height: 2px;
    background: linear-gradient(90deg, var(--gold), var(--gold-soft));
  }

  .brand-logo {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 2px 0;
  }

  .logo-mark {
    display: flex;
    gap: 2px;
    background: linear-gradient(135deg, rgba(201, 162, 39, 0.12), rgba(201, 162, 39, 0.04));
    border: 1.5px solid var(--gold);
    border-radius: 10px;
    padding: 4px 8px;
    position: relative;
    min-width: 42px;
    justify-content: center;
    flex-shrink: 0;
  }

  .logo-initial {
    font-family: 'Fraunces', serif;
    font-weight: 700;
    font-size: 20px;
    color: var(--gold);
    letter-spacing: -1px;
    line-height: 1;
  }

  .logo-initial:first-child {
    color: var(--gold-soft);
  }

  .logo-mark::after {
    content: '✦';
    position: absolute;
    font-size: 6px;
    bottom: -4px;
    right: -4px;
    color: var(--gold-soft);
    background: var(--bg);
    padding: 0 2px;
  }

  .brand-info {
    display: flex;
    flex-direction: column;
  }

  .brand-name {
    font-family: 'Fraunces', serif;
    font-weight: 600;
    font-size: 16px;
    letter-spacing: 0.02em;
    color: var(--text);
    line-height: 1.2;
  }

  .brand-name span {
    font-weight: 300;
    color: var(--muted);
    letter-spacing: 0.06em;
  }

  .brand-tagline {
    font-family: 'Inter', sans-serif;
    font-size: 9px;
    color: var(--gold-soft);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-top: 1px;
    opacity: 0.8;
  }

  .brand-eyebrow {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 9px;
    letter-spacing: .14em;
    color: var(--gold);
    text-transform: uppercase;
    margin-bottom: 2px;
  }

  h1 {
    font-family: 'Fraunces', serif;
    font-weight: 600;
    font-size: 24px;
    letter-spacing: -0.01em;
    margin-bottom: 2px;
  }

  h1 span {
    color: var(--gold-soft);
    font-style: italic;
    font-weight: 400;
  }

  .subtitle {
    color: var(--muted);
    font-size: 11px;
    margin-top: 2px;
    opacity: 0.8;
    line-height: 1.4;
  }

  /* ===== TOP ROW ===== */
  .top-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 8px;
    padding: 6px 0;
    width: 100%;
  }

  .top-row-left {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: 1;
    min-width: 200px;
  }

  .top-row-right {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    flex: 1;
    min-width: 200px;
  }

  .total-attend {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 4px 12px 4px 10px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    white-space: nowrap;
    flex-shrink: 0;
    cursor: pointer;
    transition: 0.2s;
  }

  .total-attend:hover {
    border-color: var(--gold);
  }

  .total-attend .label {
    font-size: 9px;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-weight: 600;
  }

  .total-attend .count {
    font-family: 'Fraunces', serif;
    font-size: 20px;
    font-weight: 700;
    color: var(--gold-soft);
    line-height: 1;
    cursor: pointer;
  }

  .total-attend .count-sub {
    font-size: 9px;
    color: var(--faint);
    font-weight: 400;
  }

  .date-controls {
    display: flex;
    align-items: center;
    gap: 6px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 3px 8px 3px 10px;
    flex-shrink: 0;
    flex-wrap: wrap;
  }

  .date-controls label {
    font-size: 9px;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-weight: 600;
  }

  .date-controls input[type="date"] {
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 4px 8px;
    color: var(--text);
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    outline: none;
    width: 120px;
  }

  .date-controls input[type="date"]:focus {
    border-color: var(--gold);
  }

  .date-controls .today-btn {
    background: var(--gold);
    color: #1B1508;
    border: none;
    border-radius: 4px;
    padding: 4px 10px;
    font-size: 9px;
    font-weight: 700;
    font-family: 'Inter', sans-serif;
    cursor: pointer;
    transition: 0.2s;
    flex-shrink: 0;
  }

  .date-controls .today-btn:hover {
    background: var(--gold-soft);
  }

  .sync-status {
    font-size: 9px;
    color: var(--muted);
    font-family: 'IBM Plex Mono', monospace;
    display: flex;
    align-items: center;
    gap: 4px;
    flex-shrink: 0;
  }

  .sync-status .dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--teal);
  }

  .sync-status .dot.error {
    background: var(--rust);
  }

  .sync-btn {
    background: var(--surface-2);
    border: 1px solid var(--line);
    color: var(--muted);
    padding: 4px 10px;
    border-radius: 6px;
    font-size: 10px;
    font-family: 'Inter', sans-serif;
    cursor: pointer;
    transition: 0.2s;
    flex-shrink: 0;
  }

  .sync-btn:hover {
    border-color: var(--gold);
    color: var(--text);
  }

  .last-sync {
    font-size: 8px;
    color: var(--faint);
    font-family: 'IBM Plex Mono', monospace;
    flex-shrink: 0;
  }

  .razor-line {
    height: 1px;
    margin: 12px 0 18px;
    background: linear-gradient(90deg, var(--gold) 0%, var(--line) 18%, var(--line) 82%, var(--gold) 100%);
    opacity: .6;
  }

  /* ===== Stats Cards ===== */
  .stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    margin-bottom: 18px;
  }

  .stat-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 12px 14px 10px;
    position: relative;
    overflow: hidden;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    cursor: default;
  }

  .stat-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(201, 162, 39, 0.06);
  }

  .stat-label {
    font-size: 8px;
    text-transform: uppercase;
    letter-spacing: .06em;
    color: var(--muted);
    font-weight: 600;
  }

  .stat-value {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 18px;
    font-weight: 600;
    margin-top: 4px;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .stat-sub {
    font-size: 8px;
    color: var(--faint);
    margin-top: 2px;
  }

  /* ===== TWO COLUMN PANELS ===== */
  .panel-grid-2 {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
    margin-bottom: 14px;
  }

  .panel {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 16px;
  }

  .panel h2 {
    font-family: 'Fraunces', serif;
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 2px;
  }

  .panel .panel-sub {
    font-size: 10px;
    color: var(--muted);
    margin-bottom: 10px;
  }

  /* ===== TABLES ===== */
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 11px;
  }

  th {
    text-align: left;
    font-size: 8px;
    text-transform: uppercase;
    letter-spacing: .05em;
    color: var(--muted);
    padding: 4px 6px;
    border-bottom: 1px solid var(--line);
    font-weight: 600;
  }

  td {
    padding: 5px 6px;
    border-bottom: 1px solid var(--line);
  }

  tr:last-child td {
    border-bottom: none;
  }

  .staff-name {
    display: flex;
    align-items: center;
    gap: 6px;
    font-weight: 600;
    font-size: 11px;
  }

  .avatar {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--surface-2);
    border: 1px solid var(--gold);
    color: var(--gold-soft);
    font-family: 'IBM Plex Mono', monospace;
    font-size: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    flex-shrink: 0;
  }

  .num {
    font-family: 'IBM Plex Mono', monospace;
    text-align: right;
    font-size: 11px;
  }

  .clickable-count {
    cursor: pointer;
    transition: 0.2s;
    padding: 1px 4px;
    border-radius: 4px;
    display: inline-block;
    font-weight: 600;
  }

  .clickable-count:hover {
    background: rgba(201, 162, 39, 0.2);
    color: var(--gold-soft);
  }

  .log-panel table td, .log-panel table th {
    padding: 6px 6px;
  }

  .empty-state {
    color: var(--faint);
    font-size: 12px;
    padding: 16px 0;
    text-align: center;
  }

  .loading {
    color: var(--muted);
    font-size: 12px;
    padding: 10px 0;
  }

  /* ===== Weekly Summary ===== */
  .weekly-summary table {
    font-size: 11px;
  }

  .weekly-summary table th {
    font-size: 8px;
    padding: 4px 5px;
  }

  .weekly-summary table td {
    padding: 5px 5px;
    font-size: 11px;
  }

  .weekly-summary .grand-total td {
    font-weight: 700;
    border-top: 2px solid var(--gold);
    color: var(--gold-soft);
    font-size: 12px;
    background: rgba(201, 162, 39, 0.06);
  }

  .weekly-summary .period-label {
    color: var(--muted);
    font-size: 10px;
    font-weight: 500;
  }

  .weekly-summary .day-label {
    color: var(--faint);
    font-size: 9px;
  }

  .weekly-summary .amount-format {
    font-size: 11px;
  }

  /* ===== Scroll Containers ===== */
  .scroll-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    margin: 0 -4px;
    padding: 0 4px;
  }

  .scroll-wrap::-webkit-scrollbar {
    height: 4px;
  }

  .scroll-wrap::-webkit-scrollbar-track {
    background: var(--surface-2);
    border-radius: 2px;
  }

  .scroll-wrap::-webkit-scrollbar-thumb {
    background: var(--line);
    border-radius: 2px;
  }

  .scroll-wrap::-webkit-scrollbar-thumb:hover {
    background: var(--gold);
  }

  .log-scroll {
    max-height: 300px;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }

  .log-scroll::-webkit-scrollbar {
    width: 4px;
  }

  .log-scroll::-webkit-scrollbar-track {
    background: var(--surface-2);
    border-radius: 2px;
  }

  .log-scroll::-webkit-scrollbar-thumb {
    background: var(--line);
    border-radius: 2px;
  }

  .log-scroll::-webkit-scrollbar-thumb:hover {
    background: var(--gold);
  }

  .log-scroll table {
    font-size: 10px;
  }

  .log-scroll table th {
    font-size: 8px;
    padding: 4px 6px;
  }

  .log-scroll table td {
    padding: 5px 6px;
    font-size: 10px;
  }

  /* ===== MODAL ===== */
  .modal-overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.8);
    z-index: 10000;
    justify-content: center;
    align-items: center;
    backdrop-filter: blur(4px);
    padding: 16px;
  }

  .modal-overlay.active {
    display: flex;
  }

  .modal {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 20px 16px 16px;
    max-width: 500px;
    width: 100%;
    max-height: 85vh;
    overflow-y: auto;
    position: relative;
    box-shadow: 0 20px 60px rgba(0,0,0,0.8);
  }

  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--line);
  }

  .modal-header h3 {
    font-family: 'Fraunces', serif;
    font-size: 16px;
    font-weight: 600;
    color: var(--text);
  }

  .modal-header h3 span {
    color: var(--gold-soft);
  }

  .modal-close {
    background: none;
    border: none;
    color: var(--muted);
    font-size: 20px;
    cursor: pointer;
    transition: 0.2s;
    padding: 0 4px;
  }

  .modal-close:hover {
    color: var(--rust);
  }

  .modal table {
    font-size: 11px;
  }

  .modal table th {
    font-size: 8px;
    padding: 4px 6px;
  }

  .modal table td {
    padding: 5px 6px;
    font-size: 10px;
  }

  .modal .modal-total {
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px solid var(--line);
    text-align: right;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    color: var(--gold-soft);
  }

  .modal::-webkit-scrollbar {
    width: 4px;
  }

  .modal::-webkit-scrollbar-track {
    background: var(--surface-2);
    border-radius: 2px;
  }

  .modal::-webkit-scrollbar-thumb {
    background: var(--line);
    border-radius: 2px;
  }

  /* ===== TOAST ===== */
  #toast-container {
    position: fixed;
    top: 12px;
    right: 12px;
    left: 12px;
    z-index: 9999;
    display: flex;
    flex-direction: column;
    gap: 6px;
    max-width: 400px;
    margin: 0 auto;
  }

  .toast {
    padding: 10px 16px;
    border-radius: 8px;
    background: var(--surface);
    border: 1px solid var(--line);
    color: var(--text);
    font-size: 12px;
    animation: slideIn 0.3s ease;
    box-shadow: 0 10px 30px rgba(0,0,0,0.5);
  }

  .toast-success {
    border-left: 3px solid var(--teal);
  }

  .toast-error {
    border-left: 3px solid var(--rust);
  }

  .toast-info {
    border-left: 3px solid var(--gold);
  }

  @keyframes slideIn {
    from {
      transform: translateX(100%);
      opacity: 0;
    }
    to {
      transform: translateX(0);
      opacity: 1;
    }
  }

  /* ===== RESPONSIVE BREAKPOINTS ===== */
  @media(min-width: 768px){
    body { padding: 24px 20px 50px; }
    .brand-name { font-size: 18px; }
    h1 { font-size: 28px; }
    .stats { grid-template-columns: repeat(3, 1fr); }
    .panel-grid-2 { grid-template-columns: 1fr 1fr; }
    .top-row { flex-wrap: nowrap; }
  }

  @media(min-width: 1024px){
    body { padding: 32px 28px 60px; }
    .brand-name { font-size: 20px; }
    h1 { font-size: 32px; }
    .stats { grid-template-columns: repeat(5, 1fr); }
    .panel-grid-2 { grid-template-columns: 0.9fr 1.1fr; }
  }

  @media(max-width: 480px){
    .top-row-left { min-width: 100%; }
    .top-row-right { min-width: 100%; justify-content: flex-start; }
    .date-controls { width: 100%; }
    .date-controls input[type="date"] { flex: 1; min-width: 80px; }
    .total-attend { flex: 1; justify-content: center; }
    .stat-value { font-size: 16px; }
    .weekly-summary table { font-size: 10px; }
    .weekly-summary table td { font-size: 10px; padding: 4px 4px; }
    .weekly-summary table th { font-size: 7px; padding: 3px 4px; }
    .staff-matrix table { font-size: 10px; }
    .staff-matrix table td { font-size: 10px; padding: 4px 4px; }
    .staff-matrix table th { font-size: 7px; padding: 3px 4px; }
    .staff-name { font-size: 10px; }
    .num { font-size: 10px; }
    .log-scroll table { font-size: 9px; }
    .log-scroll table td { font-size: 9px; padding: 4px 4px; }
    .log-scroll table th { font-size: 7px; padding: 3px 4px; }
    .modal { padding: 14px 12px; }
    .modal table td, .modal table th { font-size: 9px; padding: 3px 4px; }
  }
</style>
</head>
<body>
<div class="wrap">

  <header>
    <div class="header-main">
      <div class="brand-section">
        <div class="brand-logo">
          <div class="logo-mark">
            <span class="logo-initial">Y</span>
            <span class="logo-initial">S</span>
          </div>
          <div class="brand-info">
            <div class="brand-name">YOURS <span>SALON</span></div>
            <div class="brand-tagline">✦ Look Good, Feel Confident</div>
          </div>
        </div>
      </div>

      <div class="brand-eyebrow">Salon Operations · Daily Ledger</div>
      <h1>Chair<span>&</span>Ledger</h1>
      <div class="subtitle" id="staffSubtitle">Loading staff list...</div>

      <div class="top-row">
        <div class="top-row-left">
          <div class="date-controls">
            <label>📅</label>
            <input type="date" id="datePicker">
            <button class="today-btn" id="todayBtn">Today</button>
          </div>
        </div>

        <div class="top-row-right">
          <div class="total-attend" id="totalAttendBtn" title="Click to view all entries">
            <span class="label">👥</span>
            <span class="count" id="totalAttendCount">0</span>
            <span class="count-sub" id="totalAttendSub">txns</span>
          </div>

          <div class="sync-status" id="syncStatus">
            <span class="dot" id="syncDot"></span>
            <span id="syncText">Loading</span>
          </div>
          <span class="last-sync" id="lastSyncTime"></span>
          <button class="sync-btn" id="manualSyncBtn">⟳ Sync</button>
        </div>
      </div>
    </div>
  </header>

  <div class="razor-line"></div>

  <!-- Stats Cards -->
  <div class="stats" id="statCards">
    <div class="stat-card staff">
      <div class="stat-label">1. Staff Collection</div>
      <div class="stat-value" id="statStaff">₹0</div>
    </div>
    <div class="stat-card cost">
      <div class="stat-label">2. Cost Cutting</div>
      <div class="stat-value" id="statCost">₹0</div>
    </div>
    <div class="stat-card cash">
      <div class="stat-label">3. Cash Collection</div>
      <div class="stat-value" id="statCash">₹0</div>
      <div class="stat-sub" id="statCashSub">Cash</div>
    </div>
    <div class="stat-card online">
      <div class="stat-label">4. Online Collection</div>
      <div class="stat-value" id="statOnline">₹0</div>
      <div class="stat-sub" id="statOnlineSub">Online</div>
    </div>
    <div class="stat-card total">
      <div class="stat-label">5. Collection Today</div>
      <div class="stat-value" id="statTotal">₹0</div>
      <div class="stat-sub" id="statTotalSub">Staff + Cost</div>
    </div>
  </div>

  <!-- Two Column Grid -->
  <div class="panel-grid-2">
    <!-- Staff Matrix -->
    <div class="panel staff-matrix">
      <h2>Staff Matrix</h2>
      <div class="panel-sub" id="matrixSub">Totals per staff</div>
      <div class="scroll-wrap">
        <table id="matrixTable">
          <thead>
            <tr>
              <th>Staff</th>
              <th style="text-align:right">Collection</th>
              <th style="text-align:right">Cost</th>
              <th style="text-align:right">Attend</th>
            </tr>
          </thead>
          <tbody id="matrixBody"></tbody>
        </table>
      </div>
    </div>

    <!-- Weekly Summary -->
    <div class="panel weekly-summary">
      <h2>Weekly Summary</h2>
      <div class="panel-sub" id="weeklySub">Data-driven summary</div>
