// ========================================
// PARSE TIMESTAMP
// ========================================

function parseTimestamp(ts) {
  if (!ts) return null;
  
  const ddmmyyMatch = ts.match(/(\d{2})\/(\d{2})\/(\d{4})\s+(\d{2}):(\d{2}):(\d{2})/);
  if (ddmmyyMatch) {
    const day = ddmmyyMatch[1];
    const month = ddmmyyMatch[2];
    const year = ddmmyyMatch[3];
    const hour = ddmmyyMatch[4];
    const min = ddmmyyMatch[5];
    const sec = ddmmyyMatch[6];
    return `${year}-${month}-${day} ${hour}:${min}:${sec}`;
  }
  
  const ddmmyyOnly = ts.match(/(\d{2})\/(\d{2})\/(\d{4})/);
  if (ddmmyyOnly) {
    const day = ddmmyyOnly[1];
    const month = ddmmyyOnly[2];
    const year = ddmmyyOnly[3];
    return `${year}-${month}-${day}`;
  }
  
  const yyyymmddMatch = ts.match(/(\d{4}-\d{2}-\d{2})/);
  if (yyyymmddMatch) {
    return yyyymmddMatch[1];
  }
  
  const d = new Date(ts);
  if (!isNaN(d.getTime())) {
    return d.toISOString();
  }
  
  return ts;
}

// ========================================
// GOOGLE SHEETS API FETCH
// ========================================

async function fetchGoogleSheetsData() {
  try {
    console.log('Fetching from Google Sheets API...');
    
    const url = `https://sheets.googleapis.com/v4/spreadsheets/${SHEET_ID}/values/Form%20responses%201?key=${API_KEY}`;
    
    const response = await fetch(url);
    
    if (!response.ok) {
      const errorText = await response.text();
      console.error('API Error Response:', errorText);
      
      if (response.status === 404) {
        throw new Error('Sheet not found. Make sure sheet is shared.');
      } else if (response.status === 403) {
        throw new Error('API key invalid or Sheet API not enabled.');
      } else {
        throw new Error(`HTTP ${response.status}: ${errorText}`);
      }
    }
    
    const result = await response.json();
    console.log('API Response received');
    
    if (!result.values || result.values.length < 2) {
      throw new Error('No data found in sheet. Add some data first.');
    }
    
    const headers = result.values[0];
    console.log('Headers:', headers);
    console.log('Total rows in sheet (including header):', result.values.length);
    
    const colIndex = {
      timestamp: headers.findIndex(h => h && h.toLowerCase().includes('timestamp')),
      name: headers.findIndex(h => h && h.toLowerCase().includes('your name')),
      amount: headers.findIndex(h => h && h.toLowerCase().includes('amount')),
      paymentMode: headers.findIndex(h => h && h.toLowerCase().includes('payment mode')),
      costCutting: headers.findIndex(h => h && h.toLowerCase().includes('cost cutting'))
    };
    
    if (colIndex.name === -1) {
      colIndex.name = headers.findIndex(h => h && h.toLowerCase().includes('name'));
    }
    
    console.log('Column indices:', colIndex);
    
    if (colIndex.name === -1) {
      throw new Error('"Your Name" column not found.');
    }
    
    if (colIndex.amount === -1) {
      throw new Error('"Amount" column not found.');
    }
    
    const data = [];
    let skippedCount = 0;
    
    for (let i = 1; i < result.values.length; i++) {
      const row = result.values[i];
      
      if (!row || row.length === 0 || !row[colIndex.name]) {
        skippedCount++;
        continue;
      }
      
      const name = row[colIndex.name] ? row[colIndex.name].trim() : '';
      const amount = colIndex.amount !== -1 ? parseFloat(row[colIndex.amount]) || 0 : 0;
      const paymentMode = colIndex.paymentMode !== -1 && row[colIndex.paymentMode] ? row[colIndex.paymentMode].trim() : '';
      const costCutting = colIndex.costCutting !== -1 ? parseFloat(row[colIndex.costCutting]) || 0 : 0;
      
      let rawTimestamp = '';
      let date = todayStr();
      
      if (colIndex.timestamp !== -1 && row[colIndex.timestamp]) {
        rawTimestamp = row[colIndex.timestamp].trim();
        const ts = rawTimestamp;
        
        const ddmmyyMatch = ts.match(/(\d{2})\/(\d{2})\/(\d{4})/);
        if (ddmmyyMatch) {
          const day = ddmmyyMatch[1];
          const month = ddmmyyMatch[2];
          const year = ddmmyyMatch[3];
          date = `${year}-${month}-${day}`;
        } else {
          const yyyymmddMatch = ts.match(/(\d{4}-\d{2}-\d{2})/);
          if (yyyymmddMatch) {
            date = yyyymmddMatch[1];
          } else {
            const d = new Date(ts);
            if (!isNaN(d.getTime())) {
              date = d.toISOString().slice(0, 10);
            }
          }
        }
      }
      
      if (!name) {
        skippedCount++;
        continue;
      }
      
      data.push({
        id: Date.now() + i + Math.random(),
        date: date,
        rawTimestamp: rawTimestamp,
        employee: name,
        amount: amount,
        paymentMode: paymentMode,
        saving: costCutting
      });
    }
    
    console.log('Total valid data rows:', data.length);
    console.log('Skipped rows:', skippedCount);
    return data;
    
  } catch (error) {
    console.error('Error fetching Google Sheets data:', error);
    showToast('⚠️ ' + error.message, 'error');
    return null;
  }
}

