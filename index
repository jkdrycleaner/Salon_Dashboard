function renderWeeklySummary() {
  const monthlyEntries = getMonthlyEntries();
  const currentDate = new Date(selectedDate || todayStr());
  const currentMonth = currentDate.getMonth();
  const currentYear = currentDate.getFullYear();
  
  const datesWithData = [...new Set(monthlyEntries.map(e => e.date))].sort();
  const staffNames = staffList.length > 0 ? staffList : ['No staff'];
  
  const lastDayOfMonth = new Date(currentYear, currentMonth + 1, 0).getDate();
  const weekRanges = [
    { label: 'Week 1', start: 1, end: 7 },
    { label: 'Week 2', start: 8, end: 14 },
    { label: 'Week 3', start: 15, end: 21 },
    { label: 'Week 4', start: 22, end: lastDayOfMonth }
  ];
  
  const activeWeeks = weekRanges.filter(week => {
    for (let d = week.start; d <= week.end; d++) {
      const dateStr = `${currentYear}-${String(currentMonth + 1).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
      if (monthlyEntries.some(e => e.date === dateStr)) {
        return true;
      }
    }
    return false;
  });
  
  const summaryData = {};
  staffNames.forEach(name => {
    summaryData[name] = {
      totalWeeks: 0,
      days: {},
      weeks: {}
    };
    
    datesWithData.forEach(date => {
      summaryData[name].days[date] = 0;
    });
    
    activeWeeks.forEach(week => {
      summaryData[name].weeks[week.label] = 0;
    });
  });
  
  monthlyEntries.forEach(entry => {
    const staffName = entry.employee;
    if (summaryData[staffName]) {
      if (summaryData[staffName].days[entry.date] !== undefined) {
        summaryData[staffName].days[entry.date] += entry.amount;
      }
      
      const day = parseInt(entry.date.slice(8, 10));
      activeWeeks.forEach(week => {
        if (day >= week.start && day <= week.end) {
          summaryData[staffName].weeks[week.label] += entry.amount;
        }
      });
      
      summaryData[staffName].totalWeeks += entry.amount;
    }
  });
  
  const thead = document.getElementById('weeklyTable').querySelector('thead');
  const tbody = document.getElementById('weeklyBody');
  
  let headerHTML = '<th>Period</th>';
  staffNames.forEach(name => {
    headerHTML += `<th style="text-align:right">${name}</th>`;
  });
  headerHTML += `<th style="text-align:right;color:var(--gold-soft);">Total</th>`;
  thead.innerHTML = `<tr>${headerHTML}</tr>`;
  
  let bodyHTML = '';
  
  const sortedDates = [...datesWithData].sort((a, b) => b.localeCompare(a));
  
  sortedDates.forEach(date => {
    const dayNum = parseInt(date.slice(8, 10));
    const dateDisplay = formatDate(date);
    const dayLabel = `Day ${dayNum}`;
    
    let rowHTML = `<td><span class="day-label">${dayLabel}</span> <span style="color:var(--muted);font-size:8px;">(${dateDisplay})</span></td>`;
    let hasData = false;
    let rowTotal = 0;
    
    staffNames.forEach(name => {
      const amount = summaryData[name].days[date] || 0;
      if (amount > 0) hasData = true;
      rowTotal += amount;
      rowHTML += `<td class="num amount-format">${amount > 0 ? inr(amount) : ''}</td>`;
    });
    
    rowHTML += `<td class="num amount-format" style="font-weight:600;color:var(--gold-soft);">${rowTotal > 0 ? inr(rowTotal) : ''}</td>`;
    
    if (hasData) {
      bodyHTML += `<tr>${rowHTML}</tr>`;
    }
  });
  
  activeWeeks.forEach(week => {
    let rowHTML = `<td class="period-label">${week.label}</td>`;
    let hasData = false;
    let rowTotal = 0;
    
    staffNames.forEach(name => {
      const amount = summaryData[name].weeks[week.label] || 0;
      if (amount > 0) hasData = true;
      rowTotal += amount;
      rowHTML += `<td class="num amount-format">${amount > 0 ? inr(amount) : ''}</td>`;
    });
    
    rowHTML += `<td class="num amount-format" style="font-weight:600;color:var(--gold-soft);">${rowTotal > 0 ? inr(rowTotal) : ''}</td>`;
    
    if (hasData) {
      bodyHTML += `<tr>${rowHTML}</tr>`;
    }
  });
  
  let totalHTML = `<td style="font-weight:700;color:var(--gold-soft);font-size:13px;">Grand Total</td>`;
  let grandTotal = 0;
  staffNames.forEach(name => {
    const total = summaryData[name].totalWeeks;
    grandTotal += total;
    totalHTML += `<td class="num" style="font-weight:700;color:var(--gold-soft);font-size:13px;">${total > 0 ? inr(total) : ''}</td>`;
  });
  totalHTML += `<td class="num" style="font-weight:700;color:var(--gold-soft);font-size:13px;">${grandTotal > 0 ? inr(grandTotal) : ''}</td>`;
  bodyHTML += `<tr class="grand-total">${totalHTML}</tr>`;
  
  tbody.innerHTML = bodyHTML;
  
  document.getElementById('weeklySub').textContent = `${datesWithData.length} days, ${activeWeeks.length} weeks`;
}

function renderLog() {
  const loading = document.getElementById('logLoading');
  const table = document.getElementById('logTable');
  const empty = document.getElementById('emptyState');
  const scrollContainer = document.getElementById('logScrollContainer');
  
  loading.style.display = 'none';

  if (entries.length === 0) {
    table.style.display = 'none';
    empty.style.display = 'block';
    return;
  }
  
  empty.style.display = 'none';
  table.style.display = 'table';
  scrollContainer.style.display = 'block';

  const sorted = [...entries].sort((a, b) => {
    const dateCompare = b.date.localeCompare(a.date);
    if (dateCompare !== 0) return dateCompare;
    
    if (a.rawTimestamp && b.rawTimestamp) {
      const aParsed = parseTimestamp(a.rawTimestamp);
      const bParsed = parseTimestamp(b.rawTimestamp);
      const aDate = new Date(aParsed);
      const bDate = new Date(bParsed);
      if (!isNaN(aDate.getTime()) && !isNaN(bDate.getTime())) {
        return bDate.getTime() - aDate.getTime();
      }
    }
    return b.id - a.id;
  });
  
  const body = document.getElementById('logBody');
  body.innerHTML = '';
  
  sorted.forEach(e => {
    const displayDate = e.rawTimestamp || e.date;
    const tr = document.createElement('tr');
    tr.innerHTML = `
      <td>${displayDate}</td>
      <td>${e.employee}</td>
      <td class="num">${inr(e.amount)}</td>
      <td class="num">${e.paymentMode || '-'}</td>
      <td class="num">${inr(e.saving)}</td>
    `;
    body.appendChild(tr);
  });
}

