  openModal(`👤 ${staffName} - ${date}`, staffEntries);
}

function openTotalModal() {
  const todayEntries = getSelectedDateEntries();
  const displayDate = selectedDate || todayStr();
  
  if (todayEntries.length === 0) {
    showToast('ℹ️ No entries found for this date.', 'info');
    return;
  }
  
  openModal(`📋 All Entries - ${displayDate}`, todayEntries);
}

function closeModal() {
  const overlay = document.getElementById('modalOverlay');
  overlay.classList.remove('active');
  document.body.style.overflow = '';
}

// ========================================
// EVENT HANDLERS
// ========================================

document.getElementById('totalAttendBtn').addEventListener('click', openTotalModal);
document.getElementById('modalCloseBtn').addEventListener('click', closeModal);

document.getElementById('modalOverlay').addEventListener('click', function(e) {
  if (e.target === this) {
    closeModal();
  }
});

document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') {
    closeModal();
  }
});

document.getElementById('datePicker').addEventListener('change', function() {
  selectedDate = this.value;
  console.log('Date changed to:', selectedDate);
  renderAll();
});

document.getElementById('todayBtn').addEventListener('click', function() {
  const today = todayStr();
  document.getElementById('datePicker').value = today;
  selectedDate = today;
  console.log('Reset to today:', today);
  renderAll();
});

document.getElementById('manualSyncBtn').addEventListener('click', () => {
  syncWithGoogleSheets(false);
});

// ========================================
// AUTO-SYNC
// ========================================

function startAutoSync() {
  if (autoSyncInterval) {
    clearInterval(autoSyncInterval);
  }
  
  autoSyncInterval = setInterval(() => {
    console.log('🔄 Auto-sync triggered (every 1 minute)');
    syncWithGoogleSheets(true);
  }, 60000);
  
  console.log('✅ Auto-sync enabled - syncing every 1 minute');
}

// ========================================
// INITIALIZATION
// ========================================

(async function init() {
  console.log('Dashboard initializing...');
  
  document.getElementById('datePicker').value = todayStr();
  selectedDate = todayStr();
  
  await loadEntries();
  console.log('Local entries loaded:', entries.length);
  
  staffList = extractStaffNames(entries);
  updateSubtitle();
  console.log('Staff list from localStorage:', staffList);
  
  await syncWithGoogleSheets(false);
  
  renderAll();
  
  startAutoSync();
  
  document.getElementById('syncText').textContent = 'Auto ON';
  document.getElementById('syncDot').className = 'dot';
  console.log('Dashboard ready - auto-sync every 1 minute');
})();

document.addEventListener('visibilitychange', () => {
  if (!document.hidden) {
    console.log('Tab visible - auto syncing...');
    syncWithGoogleSheets(true);
  }
});

window.addEventListener('beforeunload', () => {
  if (autoSyncInterval) {
    clearInterval(autoSyncInterval);
  }
});
</script>
</body>
</html>
