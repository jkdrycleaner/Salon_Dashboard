function openModal(title, entriesForDate) {
  const overlay = document.getElementById('modalOverlay');
  const modalBody = document.getElementById('modalBody');
  const modalTitle = document.getElementById('modalTitle');
  const modalTotal = document.getElementById('modalTotal');
  
  modalTitle.textContent = title;
  modalBody.innerHTML = '';
  
  let totalAmount = 0;
  
  const sorted = [...entriesForDate].sort((a, b) => {
    if (a.rawTimestamp && b.rawTimestamp) {
      const aParsed = parseTimestamp(a.rawTimestamp);
      const bParsed = parseTimestamp(b.rawTimestamp);
      const aDate = new Date(aParsed);
      const bDate = new Date(bParsed);
      if (!isNaN(aDate.getTime()) && !isNaN(bDate.getTime())) {
        return bDate.getTime() - aDate.getTime();
      }
    }
    return b.id - a.id;
  });
  
  sorted.forEach((e, index) => {
    totalAmount += e.amount;
    const tr = document.createElement('tr');
    tr.innerHTML = `
      <td>${index + 1}</td>
      <td>${e.employee}</td>
      <td class="num">${e.paymentMode || '-'}</td>
      <td class="num">${inr(e.amount)}</td>
      <td class="num">${inr(e.saving)}</td>
    `;
    modalBody.appendChild(tr);
  });
  
  modalTotal.textContent = `Total: ${inr(totalAmount)} | ${sorted.length} entries`;
  overlay.classList.add('active');
  document.body.style.overflow = 'hidden';
}

function openStaffModal(staffName, date) {
  const staffEntries = entries.filter(e => e.employee === staffName && e.date === date);
  
  if (staffEntries.length === 0) {
    showToast(`ℹ️ No entries found for ${staffName} on ${date}`, 'info');
    return;
